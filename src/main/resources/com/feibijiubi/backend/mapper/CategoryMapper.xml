<!--定义Mapper映射文件的约束和基本结构-->
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.feibijiubi.backend.video.mapper.CategoryMapper">
    <select id="categoryList" resultType="com.feibijiubi.backend.video.entity.Category">
        select * FROM category
    </select>

    <select id="selectByMcIdAndScId" resultType="com.feibijiubi.backend.video.entity.Category">
        SELECT mc_id, sc_id, mc_name, sc_name, description, rcm_tags
        FROM category
        WHERE mc_id = #{mcId}
          AND sc_id = #{scId}
    </select>
</mapper>