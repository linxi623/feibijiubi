spring:
  application:
    name: backend

  datasource:
    # Local development defaults. Docker Compose overrides these with SPRING_DATASOURCE_*.
    url: jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:feibijiubi}?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:change-me}
    driver-class-name: com.mysql.cj.jdbc.Driver

  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}
      database: 0
      connect-timeout: 3s
      timeout: 3s

  rabbitmq:
    host: ${RABBITMQ_HOST:127.0.0.1}
    # Use 25672 when connecting from the host to the Docker Compose RabbitMQ instance.
    port: ${RABBITMQ_PORT:5672}
    username: ${RABBITMQ_USERNAME:guest}
    password: ${RABBITMQ_PASSWORD:guest}
    publisher-confirm-type: correlated
    publisher-returns: true
    template:
      mandatory: true
    listener:
      simple:
        acknowledge-mode: manual
        prefetch: 20
        default-requeue-rejected: false
        auto-startup: false

app:
  external-video-source:
    # 外部播放默认开启；仍要求来源启用、线路校验通过，以及视频审核和可见性规则允许。
    playback-enabled: true
    # 管理员上游预览单独控制；不预置任何外部来源。
    preview-enabled: false
    sources: []
  video-status:
    # 四个开关 = 四个可独立部署的角色，说明见 docs/tutorial/video-status-runtime-roles.md
    # async-enabled：业务侧是否写 Outbox（false = 同步直接写统计）
    async-enabled: false
    # outbox-relay-enabled：本实例是否承担 Outbox→RabbitMQ 投递；false 不影响消费与落库
    outbox-relay-enabled: false
    # scheduling-enabled：本实例是否承担批量落库 + dirty 恢复；async=true 且此项=false 时
    # 必须有其他实例落库，否则为“无人落库”
    scheduling-enabled: true
    redis-event-ttl-days: 30
    outbox-batch-size: 100
    outbox-fixed-delay-ms: 1000
    outbox-lease-seconds: 60
    publish-confirm-timeout-seconds: 5
    consumer-max-retries: 5
    # T08：重试/DLQ 转发失败后，异步停止消费者并等待该时长后恢复（毫秒）
    consumer-recovery-delay-ms: 10000
    consumer-recovery-auto-replay-max-age-seconds: 604800
    flush-fixed-delay-ms: 500
    flush-dirty-batch-size: 100
    flush-event-batch-size: 1000
    flush-recovery-fixed-delay-ms: 5000
    # T09：status0 安全补偿默认关闭；只读 preview 永远可用。
    # 启用必须同时显式确认 processed 证据与 Redis 丢失边界（事故闸门）。
    status0-compensation-enabled: false
    status0-compensation-integrity-confirmed: false
    # 受控恢复模式，默认 false。仅当操作员明确确认“无 Redis 数据丢失、无部分写事故”时
    # 才可开启；它不自动检测单独丢 processed，也不把缺失当作未应用。
    # 事故发生时先关闭 status0-compensation-enabled 总开关。
    status0-compensation-allow-unproven-replay: false
    status0-compensation-min-age-seconds: 60
    status0-compensation-batch-size: 20
    status0-compensation-fixed-delay-ms: 5000
    status0-compensation-lease-seconds: 30
    status0-compensation-cooldown-seconds: 120
    status0-compensation-max-attempts: 5


mybatis:
  mapper-locations: classpath:com/feibijiubi/backend/mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true

jwt:
  secret: ${JWT_SECRET:replace-with-a-long-random-secret}
  expire-minutes: 1440

tencent:
  cos:
    secret-id: ${TENCENT_COS_SECRET_ID:}
    secret-key: ${TENCENT_COS_SECRET_KEY:}
    region: ${TENCENT_COS_REGION:}
    bucket: ${TENCENT_COS_BUCKET:}
    base-url: ${TENCENT_COS_BASE_URL:}
    app-id: ${TENCENT_COS_APP_ID:}
