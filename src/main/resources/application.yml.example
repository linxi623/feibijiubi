spring:
  application:
    name: backend

  datasource:
    # Local development defaults. Docker Compose overrides these with SPRING_DATASOURCE_*.
    url: jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:feibijiubi}?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:change-me}
    driver-class-name: com.mysql.cj.jdbc.Driver

  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}
      database: 0
      connect-timeout: 3s
      timeout: 3s

  rabbitmq:
    host: ${RABBITMQ_HOST:127.0.0.1}
    # Use 25672 when connecting from the host to the Docker Compose RabbitMQ instance.
    port: ${RABBITMQ_PORT:5672}
    username: ${RABBITMQ_USERNAME:guest}
    password: ${RABBITMQ_PASSWORD:guest}
    publisher-confirm-type: correlated
    publisher-returns: true
    template:
      mandatory: true
    listener:
      simple:
        acknowledge-mode: manual
        prefetch: 20
        default-requeue-rejected: false
        auto-startup: false

app:
  video-status:
    async-enabled: false
    outbox-relay-enabled: false
    scheduling-enabled: true
    redis-event-ttl-days: 30
    outbox-batch-size: 100
    outbox-fixed-delay-ms: 1000
    outbox-lease-seconds: 60
    publish-confirm-timeout-seconds: 5
    consumer-max-retries: 5
    consumer-recovery-auto-replay-max-age-seconds: 604800
    flush-fixed-delay-ms: 500
    flush-dirty-batch-size: 100
    flush-event-batch-size: 1000
    flush-recovery-fixed-delay-ms: 5000


mybatis:
  mapper-locations: classpath:com/feibijiubi/backend/mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true

jwt:
  secret: ${JWT_SECRET:replace-with-a-long-random-secret}
  expire-minutes: 1440

tencent:
  cos:
    secret-id: ${TENCENT_COS_SECRET_ID:}
    secret-key: ${TENCENT_COS_SECRET_KEY:}
    region: ${TENCENT_COS_REGION:}
    bucket: ${TENCENT_COS_BUCKET:}
    base-url: ${TENCENT_COS_BASE_URL:}
    app-id: ${TENCENT_COS_APP_ID:}
