  "moduleAssignmentDecisions": [
    {
      "subject": "existing video / interaction and cross-batch test dependencies",
      "decision": "retain existing calls; package migration does not establish architectural decoupling",
      "reason": "VideoServiceImpl imports interaction UserVideo/UserVideoMapper, while interaction services import video Video/PublishedVideoGuard. UserServiceImpl imports video VideoMapper. R4 must update all five interaction isolated-test imports when moving VideoStatusIsolatedIntegrationTests, preserving public IsolationGuard access and its safety checks. No facade or service-boundary changes are introduced in this refactor."
    },
    {
      "subject": "VideoInteractionCleanupSchedulingConfig javadoc",
      "decision": "qualify the VideoStatusSchedulingConfig link after moving out of config",
      "reason": "parent review fix for a former same-package reference; R4 must update this FQCN when the referenced stats config moves"
    },
    {
      "subject": "dto/CursorDTO, vo/CursorPageVO",
      "decision": "moved into video.dto / video.vo",
      "reason": "verified single consumer: VideoController + VideoService/VideoServiceImpl only; no cross-module consumer, so they are not shared types"
    },
    {
      "subject": "entity/UploadTempFile, mapper/UploadTempFileMapper, dto/VideoUploadPrepareDTO, vo/VideoUploadPrepareVO",
      "decision": "moved into video.entity / video.mapper / video.dto / video.vo (parent decision, option A)",
      "reason": "they belong to the video upload/publish flow. FileStorageService/TencentCosStorageServiceImpl already depend on these business types, so the move only makes the existing coupling explicit. Per plan no business restructuring is done to remove cross-module dependencies, therefore the future infrastructure storage implementation importing video.* is accepted; the storage interface/implementation themselves stay for R5 and only their imports changed"
    },
    {
      "subject": "interaction subpackage naming",
      "decision": "the redundant 'interaction' segment is dropped inside the interaction module: service/video/interaction/* -> interaction.service.*, service/impl/video/interaction/* -> interaction.service.impl.*",
      "reason": "class names, bean names (component names stay derived from the simple names), configuration prefix app.video-interaction, scheduling attributes and business behaviour are unchanged; only the package segment is removed"
    },
    {
      "subject": "converter/VideoConverter",
      "decision": "moved to video.converter",
      "reason": "only VideoServiceImpl/VideoReviewImpl consume it"
    },
    {
      "subject": "com.feibijiubi.backend.converter.ResponseConverterTests",
      "decision": "deliberately not relocated (only its imports changed, incl. a new explicit VideoConverter import)",
      "reason": "same as R2: it covers both VideoConverter (now video.converter) and UserConverter (user.converter), so it has no single module home; moving it would place user-converter assertions inside the video module"
    },
    {
      "subject": "interaction isolated tests reuse of VideoStatusIsolatedIntegrationTests.IsolationGuard",
      "decision": "VideoStatusIsolatedIntegrationTests and its nested IsolationGuard became public",
      "reason": "the five relocated interaction isolated tests keep using that shared isolation guard as the @ContextConfiguration initializer; the initializer logic, assertions, opt-in system properties and test bodies are unchanged. Public visibility on a test class is the minimum change that allows the cross-package reuse"
    }
  ],
